FROM golang:1-alpine AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ .
RUN CGO_ENABLED=0 go build -o /out/nimbus-worker ./cmd/worker

FROM alpine:3.20
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 nimbus
COPY --from=build /out/nimbus-worker /usr/local/bin/nimbus-worker
USER nimbus
ENTRYPOINT ["nimbus-worker"]
