{
  "title": "Nimbus — Storage Node Health & Replication",
  "uid": "nimbus-storage-health",
  "description": "Kept on screen during the chaos demo (docs/07-distributed-architecture.md §5): shows a node flip to down within the ~6s health TTL and placement failures stay at zero as long as N-1 nodes are healthy.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "tags": ["nimbus", "chaos-demo"],
  "panels": [
    {
      "id": 1,
      "title": "Node health (1 = healthy, 0 = down) — nimbus-api view",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "down", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "healthy", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nimbus_storage_node_healthy{job=\"nimbus-api\"}",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Current node status",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "HEALTHY", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nimbus_storage_node_healthy{job=\"nimbus-api\"}",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Chunk placement failures/sec",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(nimbus_storage_placement_failures_total[1m])",
          "legendFormat": "placement failures/sec"
        }
      ]
    }
  ]
}
