# Copy to .env (gitignored) before running docker compose.
# Postgres/Redis/NATS/MinIO endpoints are set directly in docker-compose.yml
# since they're fixed to service names on the compose network — only the
# genuinely secret/tunable values live here.

NIMBUS_ENV=dev
NIMBUS_HTTP_PORT=8080
# Dev-only placeholder secret — 32+ chars required (see config.validate()).
# Generate a real one for anything beyond local dev: openssl rand -hex 32
NIMBUS_JWT_SECRET=dev-only-secret-change-me-please-32chars-min
# Optional: set this to the OLD value of NIMBUS_JWT_SECRET while rotating it,
# so access tokens issued under the old secret keep verifying until they
# naturally expire (config.Config.JWTSecretPrevious) instead of every logged-in
# session breaking the instant you restart with a new secret. Remove once the
# old secret's max token TTL has passed.
# NIMBUS_JWT_SECRET_PREVIOUS=

# The single seeded platform-admin login (backend/internal/auth/repository.go
# EnsureSeededAdmin) — the only way to gain cluster-ops (/v1/admin/*) access.
# No other account can self-promote; change the password for anything
# beyond local dev. Held to a higher bar than regular signup passwords (see
# config.validateAdminPassword): 12+ chars, at least 3 of
# uppercase/lowercase/digit/symbol.
NIMBUS_ADMIN_EMAIL=admin@nimbus.dev
NIMBUS_ADMIN_PASSWORD=Dev-Admin-Pass1-ChangeMe!

# Per-org total storage quota. Default in config.go is 10 GiB; overridden
# here to 5 GiB (5 * 1024^3 bytes).
NIMBUS_ORG_QUOTA_BYTES=5368709120
